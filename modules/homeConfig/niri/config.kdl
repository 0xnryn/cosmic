// --- GLOBAL ENVIRONMENT VARIABLES ---
environment {
    // Forces Firefox/Zen and all apps to use the native OS file picker
    GTK_USE_PORTAL "1"
    
    // Forces Electron apps to use Wayland natively instead of XWayland
    NIXOS_OZONE_WL "1" 
}

// --- INPUT TRACKING ---
input {
    touchpad {
        tap
        dwt
        natural-scroll
    }
}

spawn-at-startup "kdeconnect-indicator"
// --- RUNTIME PIPELINE (AUTOSTART) ---
spawn-at-startup "noctalia-shell"
spawn-at-startup "kdeconnect-indicator"

// --- SYSTEMD REGISTRATION (THE PORTAL FIX) ---
spawn-at-startup "systemctl" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "NIXOS_OZONE_WL" "GTK_USE_PORTAL"
spawn-at-startup "systemctl" "--user" "start" "graphical-session.target"


// --- THE VANILLA KEYBINDING MATRIX ---
binds {
    // Core Launchers
    Mod+Space { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    // Mod+T { spawn "zeditor"; }
    // Mod+B { spawn "zen"; }
    // Stack windows vertically inside a column
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    // Vanilla Niri Ribbon Navigation (Vim-Style)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-or-monitor-up; }
    Mod+J { focus-window-or-monitor-down; }
    // Move windows around the grid
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    // Hardware Controls (Essential for laptop functionality)
    XF86AudioMute { spawn "pamixer" "-t"; }
    XF86AudioLowerVolume { spawn "pamixer" "-d" "5"; }
    XF86AudioRaiseVolume { spawn "pamixer" "-i" "5"; }
    XF86AudioMicMute { spawn "pamixer" "--default-source" "-t"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+10%"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    
    // Vanilla Niri Ribbon Navigation
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-or-monitor-up; }
    Mod+Down { focus-window-or-monitor-down; }
    
    // Session Lifecycle Rules
    Mod+Q { close-window; }
    Mod+Shift+E { quit skip-confirmation=true; }
}